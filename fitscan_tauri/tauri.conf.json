{
  "package": {
    "productName": "FitScanDesktop",
    "version": "0.1.0"
  },
  "tauri": {
    "windows": [
      {
        "title": "FitScanDesktop",
        "width": 800,
        "height": 600,
        "resizable": false,
        "fullscreen": false,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    },
    "allowlist": {
      "all": false,
      "fs": {
        "all": true,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "createDir": true,
        "removeFile": true
      },
      "dialog": { "all": true }
    },
    "updater": { "active": false },
    "menu": { "enabled": false },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.example.fitscandesk"
    }
  },
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "src",
    "distDir": "../src"
  }
}